{
  "name": "forgequote-monorepo",
  "version": "1.0.0",
  "description": "ForgeQuote — Precision Machining & Forging Quotation System for Company A (Chakan, Pune)",
  "scripts": {
    "docker:dev": "docker compose up -d --build",
    "docker:dev:down": "docker compose down",
    "docker:prod": "docker compose -f docker-compose.prod.yml up -d --build",
    "docker:prod:down": "docker compose -f docker-compose.prod.yml down",
    "docker:logs": "docker compose logs -f",
    "docker:seed:quotes": "docker compose exec server npm run seed:quotes",
    "docker:prod:seed:quotes": "docker exec forgequote_prod_server node prisma/import-historical-quotes.js",
    "test:server": "npm --prefix server test",
    "build:client": "npm --prefix client run build"
  }
}
