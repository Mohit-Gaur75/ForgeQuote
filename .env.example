# ============================================================
# ForgeQuote — Environment Variables
# Copy this file to .env and fill in real values.
# NEVER commit .env to source control.
# ============================================================

# --- Node environment ---
NODE_ENV=development

# --- PostgreSQL (used by Docker Compose postgres service) ---
POSTGRES_USER=forgequote
POSTGRES_PASSWORD=changeme_strong_password
POSTGRES_DB=forgequote

# --- Prisma DATABASE_URL ---
# For Docker Compose (uses service name "postgres"):
DATABASE_URL="postgresql://forgequote:changeme_strong_password@postgres:5432/forgequote?schema=public"
# For local development (outside Docker):
# DATABASE_URL="postgresql://forgequote:changeme_strong_password@localhost:5432/forgequote?schema=public"

# --- Session secret (min 32 chars, random, keep private) ---
SESSION_SECRET=replace_with_32_plus_random_chars_here

# --- Session config ---
SESSION_EXPIRY_HOURS=24
COOKIE_SECURE=false
# Set COOKIE_SECURE=true in production (requires HTTPS)

# --- CORS allowed origins (comma-separated) ---
CORS_ORIGIN=http://localhost:5173

# --- OpenAI API key (backend only, never expose to frontend) ---
OPENAI_API_KEY=sk-replace-with-your-openai-api-key
OPENAI_MODEL=gpt-4o-mini

# --- Rate limiting ---
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_MAX=10

# --- Application ---
PORT=4000
APP_TIMEZONE=Asia/Kolkata

# --- Seed passwords (development only) ---
SEED_ESTIMATOR_PASSWORD=Estimator@123
SEED_SALES_PASSWORD=Sales@123

# --- Approval threshold (in INR, default 2500000 = ₹25 lakh) ---
APPROVAL_THRESHOLD=2500000

# --- Frontend (Vite — must prefix with VITE_) ---
VITE_API_URL=http://localhost:4000
